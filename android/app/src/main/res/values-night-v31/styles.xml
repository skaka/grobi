<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- أندرويد 12+ يرسم شاشة إقلاع النظام بلون windowSplashScreenBackground (لا
         بـ windowBackground المركّب) — نجعلها داكنة كخلفية التطبيق. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/grobi_night</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/grobi_night</item>
    </style>
</resources>
